# Aural — environment configuration
# Copy to `.env` for local values. `.env` must never be committed.

# Audius only needs a public app name for attribution and rate-limit bucketing.
VITE_AUDIUS_APP_NAME=aural

# Optional: a free Jamendo client ID from https://developer.jamendo.com/
# Jamendo client ids are public identifiers, but keeping them out of the repo
# lets each deployment register its own attribution. Users can also paste an id
# at runtime in the app (Discover → Providers), which is stored in localStorage.
VITE_JAMENDO_CLIENT_ID=

# Optional: a secure proxy (e.g. a serverless function) that forwards provider
# requests and injects keys server-side. When set, requests are rewritten to
# ${VITE_MUSIC_PROXY_URL}/<provider>/<path>. Leave empty to call providers directly.
VITE_MUSIC_PROXY_URL=
