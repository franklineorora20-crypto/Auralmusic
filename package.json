{
  "name": "aural",
  "version": "1.0.0",
  "description": "Aural - Music for every moment",
  "author": "Aural",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "tsc -b && vite build && npm run build:server",
    "start": "NODE_ENV=production node dist-server/server.mjs",
    "lint": "tsc -b --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "electron:build:win": "npm run build && electron-builder --config electron-builder.json --win",
    "electron:build:win-dir": "npm run build && electron-builder --config electron-builder.json --win --dir",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "express": "^5.3.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
